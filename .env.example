# MediCall environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit it.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# ─── CALL-E Authentication ────────────────────────────────────────────────────
# Option 1 (recommended): use the calle CLI token cache.
#   Run `calle auth login` once — the adapter reads the token automatically.
#   Leave CALLE_API_KEY blank when using this method.
#
# Option 2: set your API key directly (e.g. for CI or Docker).
#   Get your key from https://heycall-e.com/dashboard
CALLE_API_KEY=

# CALL-E token cache location (leave blank to use default ~/.calle-mcp/cli)
# Only needed if you run calle CLI with a non-default --cache-root.
CALLE_CACHE_ROOT=

# ─── Workflow settings ────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
POLL_INTERVAL_SECONDS=2
CALL_TIMEOUT_SECONDS=300

# ─── Adapter mode ─────────────────────────────────────────────────────────────
# true  = MockCallEAdapter (safe, no real calls, no credits used)
# false = RealCallEAdapter (places actual CALL-E calls)
USE_MOCK_CALLE=true

# Scenario to replay when USE_MOCK_CALLE=true
# Options: scenario_001_confirm | scenario_002_reschedule | scenario_003_no_answer
#          scenario_004_consent_declined | scenario_005_new_symptom
#          scenario_006_ambiguous | scenario_007_medical_advice_boundary
#          scenario_008_escalation
MOCK_SCENARIO=scenario_001_confirm

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./medicall.db
