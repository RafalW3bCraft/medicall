# MediCall environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit it.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# ─── CALL-E Authentication ────────────────────────────────────────────────────
# Run `calle auth login` once — the CLI token cache is used automatically.
# No API key is required for OAuth-authenticated CLI calls.
#
# (Optional) For environments where the CLI writes tokens to a non-default
# location, override the cache root:
CALLE_CACHE_ROOT=

# (Optional) Override the calle binary path if not on $PATH:
CALLE_BIN=

# ─── Workflow settings ────────────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
POLL_INTERVAL_SECONDS=2
POLL_FIRST_SECONDS=2
CALL_TIMEOUT_SECONDS=300

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./medicall.db
