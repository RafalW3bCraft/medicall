# Copy to .env and fill in values
# CALL-E is authenticated via `calle auth login` — no API key needed here.

# Application
APP_ENV=development          # development | production
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./medicall.db

# Workflow settings
MAX_RETRY_ATTEMPTS=3
POLL_INTERVAL_SECONDS=10
CALL_TIMEOUT_SECONDS=300

# Mock adapter toggle (true = use mock, false = use real CALL-E)
USE_MOCK_CALLE=true
